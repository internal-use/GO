package main
import (
 "fmt"
 "strings"
)
func main() {
 var s, sub string
 fmt.Print("Enter a string: ")
 fmt.Scan(&s)
 fmt.Print("Enter search string: ")
 fmt.Scan(&sub)
 fmt.Println("Contains:", strings.Contains(s, sub))
 fmt.Println("ContainsAny:", strings.ContainsAny(s, sub))
 fmt.Println("Count:", strings.Count(s, sub))
 fmt.Println("EqualFold:", strings.EqualFold(s, sub))
}
