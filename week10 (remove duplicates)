package main
import "fmt"
func main() {
    var n int
    fmt.Print("Enter number of elements: ")
    fmt.Scan(&n)
    a := make([]int, n)
    m := make(map[int]bool)
    fmt.Println("Enter the elements:")
    for i := 0; i < n; i++ {
        fmt.Scan(&a[i])
    }
    fmt.Println("Slice without duplicates:")
    for _, v := range a {
        if !m[v] {
            fmt.Print(v, " ")
            m[v] = true
        }
    }
    fmt.Println()
}
