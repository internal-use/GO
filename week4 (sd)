package main
import (
    "fmt"
    "math"
)
func main() {
    var n int
    fmt.Print("Enter number of elements: ")
    fmt.Scan(&n)
    var sum float64
    numbers := make([]float64, n)
    fmt.Println("Enter the elements:")
    for i := 0; i < n; i++ {
        fmt.Scan(&numbers[i])
        sum += numbers[i]
    }
    mean := sum / float64(n)
    var variance float64
    for i := 0; i < n; i++ {
        diff := numbers[i] - mean
        variance += diff * diff
    }
    variance = variance / float64(n)
    sd := math.Sqrt(variance)
    fmt.Println("Mean:", mean)
    fmt.Println("Standard Deviation:", sd)
}


