package main
import (
    "fmt"
    "sort"
)
func main() {
    var n int
    fmt.Print("Enter number of integers: ")
    fmt.Scan(&n)
    a := make([]int, n)
    for i := 0; i < n; i++ {
        fmt.Scan(&a[i])
    }
    sort.Sort(sort.Reverse(sort.IntSlice(a)))
    fmt.Println("Integers:", a)
    fmt.Print("Enter number of strings: ")
    fmt.Scan(&n)
    s := make([]string, n)
    for i := 0; i < n; i++ {
        fmt.Scan(&s[i])
    }
    sort.Sort(sort.Reverse(sort.StringSlice(s)))
    fmt.Println("Strings:", s)
}
